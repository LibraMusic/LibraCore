func (db *SQLite) ProviderUser(ctx context.Context, provider, providerUserID string) (media.DatabaseUser, error) {
	var user media.DatabaseUser
	conn, err := db.pool.Take(ctx)
	if err != nil {
		return user, err
	}
	defer db.pool.Put(conn)

	scanned := false
	err = sqlitex.Execute(conn, `
        SELECT {{ join (prefixedColumns $.UserEntity.Columns "u.") ", " }}
        FROM users u
        JOIN auth_providers p ON u.id = p.user_id
        WHERE p.provider = ? AND p.provider_user_id = ?;`,
		&sqlitex.ExecOptions{
			ResultFunc: func(stmt *sqlite.Stmt) error {
				if scanned {
					return ErrTooMany
				}
				scanned = true

				{{- template "scanColumns" (dict "Columns" $.UserEntity.Columns "Target" "user") }}

				return nil
			},
			Args: []any{provider, providerUserID},
		},
	)
	if err != nil {
		return user, err
	}
	if !scanned {
		return user, ErrNotFound
	}

	return user, nil
}

func (db *SQLite) IsProviderLinked(ctx context.Context, provider, userID string) (bool, error) {
	conn, err := db.pool.Take(ctx)
	if err != nil {
		return false, err
	}
	defer db.pool.Put(conn)

	var exists bool
	err = sqlitex.Execute(conn, `
        SELECT EXISTS(
            SELECT 1 FROM auth_providers WHERE user_id = ? AND provider = ?
        );`,
		&sqlitex.ExecOptions{
			ResultFunc: func(stmt *sqlite.Stmt) error {
				exists = stmt.ColumnBool(0)
				return nil
			},
			Args: []any{userID, provider},
		},
	)
	return exists, err
}

